# 서버에서 .env.local 로 복사해 값을 채우세요 (.env.local 은 git에 올라가지 않음).
# 값을 바꾸면 서버를 재시작해야 반영됩니다.

# 앱 로그인 비밀번호 (단일 계정). 이 값으로만 로그인합니다. 반드시 설정하세요.
APP_PASSWORD=

# (선택) 세션 쿠키 서명 키. 비우면 APP_PASSWORD 로 대체됩니다.
# 따로 설정해두면 APP_PASSWORD 를 바꿔도 기존 로그인 세션이 유지됩니다.
SESSION_SECRET=

# Hiworks 근태 계정 (이번 주 근무시간 자동 불러오기에 사용).
# 아이디는 "도메인 포함 로그인 ID" (예: myid@smartdoctor.onhiworks.com).
HIWORKS_ID=
HIWORKS_PASSWORD=

# (선택) 자동 로그인이 막히는 오피스용 폴백. 브라우저 DevTools > Network >
# my-work-data-calendar 요청 > Request Headers 의 cookie 값 전체를 붙여넣기.
# 값에 특수문자가 많으니 반드시 작은따옴표로 감싸세요: HIWORKS_COOKIE='_hwtk=...; PHPSESSID=...'
# 만료되면 다시 붙여넣어야 합니다. 자동 로그인이 되면 비워둬도 됩니다.
HIWORKS_COOKIE=

# (선택) 로그 파일 보관 일수. logs/ 에 날짜별로 쌓이고 이 기간 넘은 파일은 자동 삭제. 기본 14.
LOG_RETENTION_DAYS=14
