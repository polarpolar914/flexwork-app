# 서버에서 .env.local 로 복사해 값을 채우세요 (.env.local 은 git에 올라가지 않음).
# 값을 바꾸면 서버를 재시작해야 반영됩니다.

# 앱 로그인 비밀번호 (단일 계정). 이 값으로만 로그인합니다. 반드시 설정하세요.
APP_PASSWORD=

# (선택) 세션 쿠키 서명 키. 비우면 APP_PASSWORD 로 대체됩니다.
# 따로 설정해두면 APP_PASSWORD 를 바꿔도 기존 로그인 세션이 유지됩니다.
SESSION_SECRET=

# Hiworks 근태 계정 (이번 주 근무시간 자동 불러오기에 사용).
# 아이디는 "아이디@오피스도메인" 형태 (예: myid@smartdoctor).
HIWORKS_ID=
HIWORKS_PASSWORD=
